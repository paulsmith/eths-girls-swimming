{{/* ABOUTME: HTML template for ETHS Wildkits Girls Swimming schedule */}}
{{/* ABOUTME: Displays swimming competition events using Go html/template with responsive design */}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ETHS Wildkits Girls Swimming Schedule</title>
    <link rel="icon" type="image/png" href="wildkit.png">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #f0f4f8;
            color: #2d3748;
            line-height: 1.6;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        header {
            background: linear-gradient(135deg, #1a2741 0%, #c34614 100%);
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .header-content {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .mascot-logo {
            height: 80px;
            width: auto;
            border-radius: 8px;
        }

        .header-text {
            text-align: center;
        }

        h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
        }

        .subtitle {
            font-size: 1.1rem;
            opacity: 0.9;
            margin-top: 0.5rem;
        }

        .calendar-actions {
            display: flex;
            justify-content: center;
            gap: 1rem;
            margin-bottom: 2rem;
            flex-wrap: wrap;
        }

        .btn {
            padding: 0.75rem 1.5rem;
            background-color: #c34614;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
            font-size: 1rem;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn:hover {
            background-color: #a03710;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(195, 70, 20, 0.4);
        }

        .btn-google {
            background-color: #1a2741;
        }

        .btn-google:hover {
            background-color: #0f1a2e;
            box-shadow: 0 4px 12px rgba(26, 39, 65, 0.4);
        }

        .btn-secondary {
            background-color: #1a2741;
        }

        .btn-secondary:hover {
            background-color: #0f1a2e;
        }

        .subscribe-note {
            text-align: center;
            margin-bottom: 2rem;
            padding: 1rem;
            background: #e0f2fe;
            border-radius: 8px;
            color: #0c4a6e;
            font-size: 0.9rem;
        }

        .competitions-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 1.5rem;
            margin-bottom: 3rem;
        }

        .competition-card {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            border: 3px solid #e5e7eb;
        }

        .competition-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
        }

        .comp-date {
            font-size: 0.9rem;
            color: #6b7280;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .comp-time {
            font-size: 1rem;
            color: #c34614;
            font-weight: 600;
            margin-bottom: 0.75rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .comp-name {
            font-size: 1.4rem;
            font-weight: 700;
            color: #1a2741;
            margin-bottom: 0.75rem;
        }

        .comp-location {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #4b5563;
            margin-bottom: 0.5rem;
        }

        .comp-type {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            background-color: #e8effa;
            color: #1a2741;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .comp-type.invitational {
            background-color: #fef3c7;
            color: #92400e;
        }

        .comp-type.relay {
            background-color: #d1fae5;
            color: #065f46;
        }

        .comp-type.meeting {
            background-color: #e9d5ff;
            color: #6b21a8;
        }

        .comp-type.conference {
            background-color: #fce7f3;
            color: #9f1239;
        }

        .comp-type.championship {
            background-color: #fee2e2;
            color: #991b1b;
        }

        .comp-type.special {
            background-color: #cffafe;
            color: #155e75;
        }

        .competition-card:not(:has(.comp-type.special)):not(:has(.comp-type.meeting)) {
            border-color: oklch(0.27 0.05 263.0);
            position: relative;
        }

        .competition-card:not(:has(.comp-type.special)):not(:has(.comp-type.meeting))::before {
            content: '';
            position: absolute;
            top: 12px;
            right: 12px;
            width: 24px;
            height: 24px;
            background-image: url("data:image/svg+xml;base64,");
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
            opacity: 0.7;
        }

        .timeline {
            position: relative;
            padding-left: 2rem;
            margin-bottom: 3rem;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 2px;
            background: #e5e7eb;
        }

        .timeline-item {
            position: relative;
            margin-bottom: 2rem;
        }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: -2.5rem;
            top: 0.5rem;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #c34614;
            border: 2px solid white;
            box-shadow: 0 0 0 2px #e5e7eb;
        }

        .competition-card.past-event {
            opacity: 0.4;
            filter: grayscale(0.7);
        }

        .timeline-item .competition-card.past-event {
            opacity: 0.4;
            filter: grayscale(0.7);
        }

        .competition-card.next-event {
            border-color: #c34614;
            border-width: 3px;
            box-shadow: 0 4px 16px rgba(195, 70, 20, 0.3);
            background: linear-gradient(135deg, #ffffff 0%, #fef5f3 100%);
        }

        .timeline-item .competition-card.next-event {
            border-color: #c34614;
            border-width: 3px;
            box-shadow: 0 4px 16px rgba(195, 70, 20, 0.3);
            background: linear-gradient(135deg, #ffffff 0%, #fef5f3 100%);
        }

        .home-indicator {
            color: #c34614;
            margin-left: 0.5rem;
            font-weight: 600;
        }

        .levels {
            margin-top: 0.5rem;
            font-size: 0.9rem;
            color: #6b7280;
        }

        @media (max-width: 768px) {
            .competitions-grid {
                grid-template-columns: 1fr;
            }

            .header-content {
                flex-direction: column;
                gap: 1rem;
            }

            .mascot-logo {
                height: 60px;
            }

            h1 {
                font-size: 2rem;
            }

            .calendar-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .btn {
                text-align: center;
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <header>
        <div class="container">
            <div class="header-content">
                <img src="wildkit.png" alt="Willie Wildkit" class="mascot-logo">
                <div class="header-text">
                    <h1>ETHS Wildkits Girls Swimming</h1>
                    <p class="subtitle">2025-2026 Competition Schedule</p>
                </div>
            </div>
        </div>
    </header>

    <div class="container">
        <div class="calendar-actions">
            <a href="https://calendar.google.com/calendar/r?cid=webcal://paulsmith.github.io/eths-girls-swimming/calendar.ics" class="btn btn-google" target="_blank">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/>
                </svg>
                Subscribe in Google Calendar
            </a>
            <a href="calendar.ics" class="btn" download>
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                </svg>
                Download Calendar (.ics)
            </a>
            <button class="btn btn-secondary" onclick="toggleView()">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M5 3a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2V5a2 2 0 00-2-2H5zM5 11a2 2 0 00-2 2v2a2 2 0 002 2h2a2 2 0 002-2v-2a2 2 0 00-2-2H5zM11 5a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V5zM14 11a1 1 0 011 1v1h1a1 1 0 110 2h-1v1a1 1 0 11-2 0v-1h-1a1 1 0 110-2h1v-1a1 1 0 011-1z"></path>
                </svg>
                Toggle View
            </button>
        </div>

        <div id="competitions-container">
            <div class="competitions-grid" id="competitions-list">
                {{range .Events}}
                <div class="competition-card">
                    <div class="comp-date">{{.Date}}</div>
                    <div class="comp-time">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
                        </svg>
                        {{.Time}}
                    </div>
                    <h3 class="comp-name">{{.Name}}</h3>
                    <div class="comp-location">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                        </svg>
                        <span title="{{.LocationFull}}">{{.Location}}</span>
                        {{if .IsHome}}<span class="home-indicator">(Home)</span>{{end}}
                    </div>
                    <div class="comp-type {{.Type}}">{{.Type}}</div>
                    {{if .Levels}}<div class="levels">{{.Levels}}</div>{{end}}
                </div>
                {{end}}
            </div>
        </div>
    </div>

    <script>
        let currentView = 'grid';
        const totalCompetitions = {{len .Events}};

        function toggleView() {
            const container = document.getElementById('competitions-container');
            const cards = document.querySelectorAll('.competition-card');

            if (currentView === 'grid') {
                // Switch to timeline view
                currentView = 'timeline';
                container.innerHTML = '<div class="timeline" id="timeline-list"></div>';
                const timeline = document.getElementById('timeline-list');

                cards.forEach(card => {
                    const timelineItem = document.createElement('div');
                    timelineItem.className = 'timeline-item';
                    timelineItem.appendChild(card.cloneNode(true));
                    timeline.appendChild(timelineItem);
                });
            } else {
                // Switch to grid view
                currentView = 'grid';
                container.innerHTML = '<div class="competitions-grid" id="competitions-list"></div>';
                const grid = document.getElementById('competitions-list');

                cards.forEach(card => {
                    grid.appendChild(card.cloneNode(true));
                });
            }
        }
        
        function mutePastEvents() {
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            
            const allCards = document.querySelectorAll('.competition-card');
            let nextEvent = null;
            let nextEventDate = null;
            
            allCards.forEach(card => {
                card.classList.remove('past-event', 'next-event');
                
                const dateElement = card.querySelector('.comp-date');
                if (dateElement) {
                    const eventDateText = dateElement.textContent.trim();
                    const eventDate = new Date(eventDateText);
                    eventDate.setHours(0, 0, 0, 0);
                    
                    if (eventDate < today) {
                        card.classList.add('past-event');
                    } else if (eventDate >= today) {
                        if (!nextEventDate || eventDate < nextEventDate) {
                            nextEvent = card;
                            nextEventDate = eventDate;
                        }
                    }
                }
            });
            
            if (nextEvent) {
                nextEvent.classList.add('next-event');
            }
        }

        mutePastEvents();

        const originalToggleView = toggleView;
        function toggleView() {
            originalToggleView();
            setTimeout(mutePastEvents, 50);
        }

        console.log(`Loaded ${totalCompetitions} competitions`);
    </script>
</body>
</html>
